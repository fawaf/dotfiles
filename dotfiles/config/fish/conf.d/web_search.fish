# conf.d/web_search.fish
# mirrors: dotfiles/zsh.conf.d/web-search.plugin.zsh (aliases; the
# web_search function itself lives in functions/web_search.fish)

abbr --add bing 'web_search bing'
abbr --add google 'web_search google'
abbr --add yahoo 'web_search yahoo'
abbr --add ddg 'web_search duckduckgo'
abbr --add sp 'web_search startpage'
abbr --add yandex 'web_search yandex'
abbr --add github 'web_search github'
abbr --add baidu 'web_search baidu'
abbr --add ecosia 'web_search ecosia'
abbr --add goodreads 'web_search goodreads'
abbr --add qwant 'web_search qwant'
abbr --add givero 'web_search givero'
abbr --add stackoverflow 'web_search stackoverflow'
abbr --add wolframalpha 'web_search wolframalpha'
abbr --add archive 'web_search archive'
abbr --add scholar 'web_search scholar'

# !bang searches
abbr --add wiki 'web_search duckduckgo \!w'
abbr --add news 'web_search duckduckgo \!n'
abbr --add youtube 'web_search duckduckgo \!yt'
abbr --add map 'web_search duckduckgo \!m'
abbr --add image 'web_search duckduckgo \!i'
abbr --add ducky 'web_search duckduckgo \!'
